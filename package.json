{
  "name": "designbase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Phase 0: a playbook-aware MCP server that briefs AI agents and checks their UI output",
  "bin": {
    "designbase": "src/cli.ts"
  },
  "scripts": {
    "mcp": "tsx src/server.ts",
    "brief": "tsx src/cli.ts brief",
    "check": "tsx src/cli.ts check",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench:prompt": "tsx bench/prompt.ts",
    "bench:shots": "tsx bench/shots.ts",
    "bench:run": "tsx bench/run.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:rescore": "tsx bench/rescore.ts",
    "serve": "node --no-warnings=ExperimentalWarning --import tsx src/api/serve.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
